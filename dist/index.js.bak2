function matchStrategyTemplate(avgAcos, campaignType) {
  if (campaignType === "SB") return 9;
  if (campaignType === "SD") return 6;
  if (avgAcos > 80) return 3;
  if (avgAcos > 50) return 6;
  if (avgAcos > 30) return 2;
  if (avgAcos > 15) return 1;
