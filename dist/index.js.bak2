    "used",
    "broken",
    "repair",
    "fix",
    "diy",
    "homemade",
    "alternative",
    "substitute",
    "replacement",
    "wholesale",
    "bulk",
    "clearance",
    "discount",
    "coupon",
    "how to",
    "what is",
    "review",
    "reviews",
    "vs",
    "versus",
    "reddit",
    "amazon",
    "ebay",
    "walmart",
    "aliexpress",
    "download",
    "pdf",
    "manual",
    "instructions"
