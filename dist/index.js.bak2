  if (denominator <= 0 || numerator <= 0) return 0;
  return Math.max(0, -Math.log(numerator / denominator) / efficiency);
}
async function estimateProfitCurve(db, accountId, campaignId, campaignName, currentBudget, daysBack = 30) {
