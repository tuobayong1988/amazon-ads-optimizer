          )).orderBy(abTestDailyMetrics.date) : [];
          const treatmentTrend = treatmentVariant ? await db.select().from(abTestDailyMetrics).where(and(
            eq(abTestDailyMetrics.testId, input.testId),
            eq(abTestDailyMetrics.variantId, treatmentVariant.id)
          )).orderBy(abTestDailyMetrics.date) : [];
          return {
            controlTrend: controlTrend.map((m) => ({
              date: m.date,
              impressions: m.impressions,
              clicks: m.clicks,
              spend: parseFloat(m.spend || "0"),
              sales: parseFloat(m.sales || "0"),
              orders: m.orders,
              acos: parseFloat(m.acos || "0"),
              roas: parseFloat(m.roas || "0"),
              ctr: parseFloat(m.ctr || "0"),
              cvr: parseFloat(m.cvr || "0")
            })),
            treatmentTrend: treatmentTrend.map((m) => ({
              date: m.date,
              impressions: m.impressions,
              clicks: m.clicks,
              spend: parseFloat(m.spend || "0"),
              sales: parseFloat(m.sales || "0"),
              orders: m.orders,
              acos: parseFloat(m.acos || "0"),
              roas: parseFloat(m.roas || "0"),
              ctr: parseFloat(m.ctr || "0"),
              cvr: parseFloat(m.cvr || "0")
            }))
          };
        } catch (e) {
          return { controlTrend: [], treatmentTrend: [] };
        }
      })
    });
  }
});

// server/optimization/nextGenMigration.ts
async function ensureNextGenTables() {
  try {
    const db = await getDb();
    if (!db) {
      return { success: false, tablesCreated: 0, error: "Database not available" };
    }
    for (const dropSql of DROP_TABLES) {
      try {
        await db.execute(sql.raw(dropSql));
      } catch (err) {
        log152.warn(`[NextGen Migration] Error dropping table:`, err.message);
      }
    }
    let tablesCreated = 0;
    for (const table of NEXTGEN_TABLES) {
      try {
        await db.execute(sql.raw(table.ddl));
        tablesCreated++;
        log152.info(`[NextGen Migration] Table '${table.name}' ensured successfully`);
      } catch (err) {
        log152.warn(`[NextGen Migration] Error creating table '${table.name}':`, err.message);
      }
    }
    return { success: true, tablesCreated };
  } catch (err) {
    return { success: false, tablesCreated: 0, error: err.message };
  }
}
