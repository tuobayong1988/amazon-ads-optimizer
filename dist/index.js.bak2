            targetingClauses
          });
          const rawRecs = response.data?.recommendations || response.data || [];
          log23.debug(`[SD] \u83B7\u53D6\u5230 ${rawRecs.length} \u4E2A\u6295\u653E\u5BF9\u8C61\u5EFA\u8BAE\u7ADE\u4EF7`);
