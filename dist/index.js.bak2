async function getNgramAnalysisSummary(accountId, campaignIds, days = 30) {
  const analysisResults = await analyzeSearchTermNgrams(accountId, campaignIds, days);
  let totalSearchTerms = 0;
  let negativeCandidates = 0;
  let highPriority = 0;
