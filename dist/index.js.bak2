        reason: `[\u81EA\u52A8\u7EA0\u9519] ${correction.reason}`,
        apiSyncStatus: "pending",
        createdAt: (/* @__PURE__ */ new Date()).toISOString().slice(0, 19).replace("T", " ")
      });
