    log157.info("[ExchangeRateService] \u6C47\u7387\u5DF2\u4FDD\u5B58\u5230\u6587\u4EF6\u7F13\u5B58");
  } catch (error46) {
    log157.warn(`[ExchangeRateService] \u6587\u4EF6\u7F13\u5B58\u5199\u5165\u5931\u8D25: ${error46.message}`);
  }
}
