            }
            if (statusCode === 404 || errorMsg.includes("API\u7AEF\u70B9\u4E0D\u5B58\u5728")) {
              log23.warn(`[SD API] v473: SD targets\u8FD4\u56DE404\uFF0C\u8BE5\u8D26\u6237\u53EF\u80FD\u672A\u5F00\u901ASD\u5E7F\u544A\uFF0C\u8DF3\u8FC7`);
