        const spAttributionSlices = Math.ceil(incremental.attribution.SP / 7);
        const sbAttributionSlices = Math.ceil(incremental.attribution.SB / 7);
        const sdAttributionSlices = Math.ceil(incremental.attribution.SD / 7);
