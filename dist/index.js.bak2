        const cvr = t2.clicks > 0 ? t2.conversions / t2.clicks : 0;
        const ctr = t2.clicks > 0 ? t2.clicks / (t2.clicks + 100) : 0;
        const score = t2.roas * 0.4 + cvr * 100 * 0.3 + t2.conversions * 0.3;
