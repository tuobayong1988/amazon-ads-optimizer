              const bidValuesArr = exprRec.bidValues || [];
              let rangeLow = 0;
              let suggestedBid = 0;
              let rangeHigh = 0;
              if (bidValuesArr.length >= 3) {
                rangeLow = Number(bidValuesArr[0]?.suggestedBid) || 0;
