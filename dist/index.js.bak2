      errors.push(`\u5E94\u7528\u5EFA\u8BAEID ${suggestionId} \u5931\u8D25: ${error46}`);
      failedCount++;
    }
  }
  return {
    success: failedCount === 0,
    appliedCount,
    failedCount,
    errors
  };
}
