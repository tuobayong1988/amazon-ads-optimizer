                  "KEYWORD_BROAD_MATCH": "BROAD",
                  "KEYWORD_PHRASE_MATCH": "PHRASE",
                  "KEYWORD_EXACT_MATCH": "EXACT",
                  "CLOSE_MATCH": "CLOSE_MATCH",
                  "LOOSE_MATCH": "LOOSE_MATCH",
                  "SUBSTITUTES": "SUBSTITUTES",
                  "COMPLEMENTS": "COMPLEMENTS"
