async function exportAuditLogsToCSV(params) {
  const { logs } = await getAuditLogs({
    ...params,
    page: 1,
    pageSize: 1e4
    // 最多导出10000条
  });
  const headers = [
    "ID",
    "\u65F6\u95F4",
    "\u64CD\u4F5C\u7528\u6237",
    "\u7528\u6237\u90AE\u7BB1",
    "\u64CD\u4F5C\u7C7B\u578B",
    "\u64CD\u4F5C\u63CF\u8FF0",
    "\u76EE\u6807\u7C7B\u578B",
    "\u76EE\u6807\u540D\u79F0",
    "\u5173\u8054\u8D26\u53F7",
    "\u72B6\u6001",
    "IP\u5730\u5740"
  ];
  const rows = logs.map((log180) => [
    log180.id,
    String(log180.createdAt),
    log180.userName || "",
    log180.userEmail || "",
    ACTION_DESCRIPTIONS[log180.actionType] || log180.actionType,
    log180.description || "",
    TARGET_TYPE_DESCRIPTIONS[log180.targetType || ""] || log180.targetType || "",
    log180.targetName || "",
    log180.accountName || "",
    log180.status,
    log180.ipAddress || ""
  ]);
  const csvContent = [
    headers.join(","),
    ...rows.map((row) => row.map((cell) => `"${String(cell).replace(/"/g, '""')}"`).join(","))
  ].join("\n");
  return csvContent;
}
