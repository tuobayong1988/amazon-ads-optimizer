      autoResponse = {
        action: "slow_down",
        bidMultiplier: 0.9,
        budgetMultiplier: 0.95,
        cooldownExtension: 1.5
      };
      log71.info(`[RiskAssessment] \u{1F7E1} YELLOW risk (score=${riskScore}) for PG ${performanceGroupId2}: ${factors.join("; ")}`);
    } else {
      level = "green";
      autoResponse = {
        action: "none",
        bidMultiplier: 1,
        budgetMultiplier: 1,
        cooldownExtension: 1
      };
    }
    return { level, score: Math.min(riskScore, 100), factors, autoResponse };
  } catch (error46) {
