  const avgScore = scores.reduce((sum2, h) => sum2 + h.score, 0) / scores.length || 1;
  const avgTrafficScore = scores.reduce((sum2, h) => sum2 + (h.trafficScore || 0), 0) / scores.length || 0.5;
  return scores.map((hourData) => {
