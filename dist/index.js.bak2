        action: "SKIP",
        targetValue: searchTerm,
        reason: `\u6570\u636E\u6821\u9A8C\u5931\u8D25: ${validation.reasonMessage}`,
        confidence: 1,
        dataMaturityLevel: "insufficient",
        valueLevel: "unknown"
