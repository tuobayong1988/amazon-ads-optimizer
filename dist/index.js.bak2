    dominantCompetitorType: dominantType,
    competitionIntensity: avgCpc > 1.5 ? 0.8 : avgCpc > 0.8 ? 0.5 : 0.2,
    cpcVolatility: 0.3,
    // 默认中等波动
    impressionConcentration: 0.5,
    // 默认中等集中度
