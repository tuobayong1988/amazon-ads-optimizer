    triggerRule: tier === "advanced" ? `\u9AD8\u7EA7\u7B97\u6CD5:${algorithmUsed}` : tier === "conservative" ? "\u4FDD\u5B88\u7B56\u7565:\u7B97\u6CD5\u5F02\u5E38\u5146\u5E95" : tier === "guardrail" ? `\u62A4\u680F\u4FDD\u62A4:${algorithmUsed}` : `\u89C4\u5219\u5F15\u64CE:${reason.split(":")[0]?.replace("[\u89C4\u5219\u5F15\u64CE] ", "") || algorithmUsed}`,
    coreMetrics: {
      clicks: target.clicks,
      impressions: target.impressions,
      spend: target.spend,
      sales: target.sales,
      orders: target.orders
    },
    algorithmChoice: `${tier}/${algorithmUsed}`,
    dataConfidence: confidence
  };
