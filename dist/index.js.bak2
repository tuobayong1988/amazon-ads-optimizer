    target.currentBid,
    "conservative",
    0.1,
    "[\u4FDD\u5B88\u7B56\u7565] \u7B97\u6CD5\u5F02\u5E38\uFF0C\u7EF4\u6301\u5F53\u524D\u51FA\u4EF7",
    "conservative"
