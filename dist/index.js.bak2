            // @ts-expect-error - type assertion
            bidDecreaseCount: Number(rl?.bid_decrease_count) || 0,
            // @ts-expect-error - type assertion
            bidHoldCount: Number(rl?.bid_hold_count) || 0,
            explorationActions: rlExplorationCount,
            advancedAlgorithm: {
              // @ts-expect-error - type assertion
