    const stat = stats2.get(alg);
    if (!stat) continue;
    const reward = Number(selLog.resultReward) || 0;
    stat.totalTrials++;
    stat.totalReward += reward;
    stat.avgReward = stat.totalReward / stat.totalTrials;
    if (reward > 0) {
      stat.alphaParam += 1;
    } else {
      stat.betaParam += 1;
    }
