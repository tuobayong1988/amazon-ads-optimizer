      ORDER BY created_at DESC
      LIMIT 1000
    `;
    const result = await db.execute(query2);
    const rows = result[0] || result;
    if (!Array.isArray(rows) || rows.length === 0) {
      return { totalIncreases: 0, avgIncreasePercent: 0, successRate: 0, byScenario: [] };
    }
