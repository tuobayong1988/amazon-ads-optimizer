      const suggestedBidFloor = suggestedBidRangeStart ? suggestedBidRangeStart * 0.5 : targetBid * 0.5;
      const safeBid = Math.max(suggestedBidFloor, Math.min(targetBid, suggestedBidCeiling, maxBid));
