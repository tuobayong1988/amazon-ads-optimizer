function buildImpressionCurve(dataPoints) {
  const validPoints = dataPoints.filter((p) => p.impressions > 0 && p.bid > 0);
  if (validPoints.length < 5) {
    return {
      a: 1e3,
      b: 0.1,
      c: 100,
