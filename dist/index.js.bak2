      ngram: result.ngram,
      matchType: result.matchType,
      frequency: result.frequency,
      totalSpend: result.totalSpend,
      totalClicks: result.totalClicks,
      totalOrders: result.totalOrders,
      acos: result.acos,
      reason: result.reason,
      priority: result.priority,
