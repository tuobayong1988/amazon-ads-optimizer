async function loadCategoryBaseline(accountId) {
  const defaultBaseline = {
    medianCpc: COLD_START_BID_CONFIG.defaultFallbackBid,
    avgConversionRate: 0.1,
    avgAov: 30,
    sampleSize: 0
  };
  try {
    const database = await getDb();
    if (!database) return defaultBaseline;
    const rows = await database.execute(sql`
      SELECT 
        SUM(spend) / NULLIF(SUM(clicks), 0) as avg_cpc,
        SUM(orders) / NULLIF(SUM(clicks), 0) as avg_cvr,
        SUM(sales) / NULLIF(SUM(orders), 0) as avg_aov,
        COUNT(DISTINCT campaign_id) as sample_size
      FROM daily_performance
      WHERE account_id = ${accountId}
        AND date >= DATE_SUB(CURDATE(), INTERVAL 30 DAY)
        AND clicks > 0
    `);
    const row = rows?.[0]?.[0];
    if (!row || !row.avg_cpc) return defaultBaseline;
    return {
      medianCpc: Math.max(0.02, parseFloat(String(row.avg_cpc)) || defaultBaseline.medianCpc),
      avgConversionRate: Math.max(0.01, parseFloat(String(row.avg_cvr)) || defaultBaseline.avgConversionRate),
      avgAov: Math.max(5, parseFloat(String(row.avg_aov)) || defaultBaseline.avgAov),
      sampleSize: parseInt(String(row.sample_size)) || 0
