        const layerResults = {};
        const runLayer = async (layerId, layerName, fn) => {
          if (!targetLayers.includes(layerId)) {
            log26.info(`[syncAll] v402: \u8DF3\u8FC7 Layer ${layerId} (${layerName}) - \u4E0D\u5728\u76EE\u6807\u5C42\u5217\u8868\u4E2D`);
            return;
