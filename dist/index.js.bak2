      } catch (e) {
        log82.info(`[PlacementOptimization] v163: ${placement} \u65F6\u95F4\u8870\u51CF\u8BA1\u7B97\u5931\u8D25\uFF0C\u4F7F\u7528\u539F\u59CB\u6C47\u603B: ${e.message}`);
      }
    }
    const { score, confidence, normalizedMetrics } = calculateEfficiencyScore(
      weightedMetrics,
      DEFAULT_WEIGHTS,
      benchmarks
