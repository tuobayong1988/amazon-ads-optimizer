            }
          }
          this.bias -= this.learningRate * dBias / nSamples;
          for (let j = 0; j < nFeatures; j++) {
            this.weights[j] -= this.learningRate * dWeights[j] / nSamples;
          }
        }
      }
      /**
       * 预测
       */
      predict(x) {
        let result = this.bias;
        for (let i = 0; i < x.length; i++) {
          result += this.weights[i] * x[i];
        }
        return result;
