    AmazonSyncService.prototype.syncSpBidRecommendations = async function() {
      const db = await getDb();
      if (!db) return { synced: 0, skipped: 0 };
      let keywordBidsUpdated = 0;
      let targetBidsUpdated = 0;
      let errors = 0;
