        bid: currentBid * (1 - reduceRatio),
        confidence: 0.4,
        reason: `\u96F6\u8F6C\u5316${clicks}\u6B21\u70B9\u51FB($${spend.toFixed(2)}, CTR=${(ctr * 100).toFixed(2)}%${zeroConvTrendLabel}): v258\u6E29\u548C\u964D\u4F4E${(reduceRatio * 100).toFixed(1)}%`
      };
