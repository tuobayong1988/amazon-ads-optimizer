        reason = `\u8FD1\u671F\u8C03\u4EF7\u540EROAS\u4E0B\u964D\u81F3${roas.toFixed(2)}\uFF0C\u5EFA\u8BAE\u56DE\u8C03\u7ADE\u4EF7`;
