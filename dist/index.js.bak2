    } else if (failCount > 0 && successCount === 0) {
      consecutiveFailures++;
      log118.warn(`[DataSyncScheduler] v336: \u540C\u6B65\u5065\u5EB7\u544A\u8B66 - \u6700\u8FD1${jobs.length}\u6B21\u540C\u6B65\u5168\u90E8\u5931\u8D25 (\u8FDE\u7EED\u5931\u8D25: ${consecutiveFailures})`);
    } else {
      consecutiveFailures = 0;
      log118.info(`[DataSyncScheduler] v336: \u540C\u6B65\u5065\u5EB7\u68C0\u67E5\u901A\u8FC7 - \u6210\u529F:${successCount}, \u5931\u8D25:${failCount}`);
