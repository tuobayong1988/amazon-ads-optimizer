  } else if (avgROAS >= 3) {
    return 70;
  } else if (avgROAS >= 1.5) {
    return 50;
  } else {
    return 30;
  }
}
function calculateOptimalRange(metrics, diminishingPoint, currentAdjustment) {
  if (metrics.marginalROAS > 1.5) {
