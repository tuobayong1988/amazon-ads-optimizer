          if (!sqsQueueArn) {
            throw new TRPCError({ code: "BAD_REQUEST", message: "\u672A\u914D\u7F6ESQS\u961F\u5217ARN\uFF0C\u8BF7\u5728\u73AF\u5883\u53D8\u91CF\u4E2D\u8BBE\u7F6EAWS_SQS_QUEUE_ARN" });
          }
