            ;
          }
          if (existing) {
            await db.update(productTargets).set(targetData).where(eq(productTargets.id, existing.id));
          } else {
            await db.insert(productTargets).values({
              ...targetData,
              createdAt: (/* @__PURE__ */ new Date()).toISOString().slice(0, 19).replace("T", " ")
            });
          }
