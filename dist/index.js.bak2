    log56.info(`v259: \u8D26\u6237${accountId} (${currencyCode}) \u53D1\u73B0${rows.length}\u6761\u51FA\u4EF7\u4E0D\u4E00\u81F4\u5019\u9009\u9879 (bidTolerance=${bidTolerance.toFixed(3)}, \u65F6\u95F4\u7A97\u53E3=1\u5929)`);
