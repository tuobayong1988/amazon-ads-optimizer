{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*", "drizzle/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts", "server/_archived/**/*", "server/_archived_v149/**/*", "server/sync/**/*"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "downlevelIteration": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@db/*": ["./drizzle/*"],
      "@db": ["./drizzle"]
    }
  }
}
