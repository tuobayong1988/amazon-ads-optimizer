files:
  /etc/nginx/conf.d/proxy.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      client_max_body_size 50M;

  /etc/nginx/conf.d/cache_control.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      # v218: 缓存控制规则
      # HTML文件和API请求禁止缓存，带哈希的静态资源长期缓存
      map $uri $cache_control_header {
        ~*\.html$  "no-cache, no-store, must-revalidate";
        ~*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$  "public, max-age=31536000, immutable";
        default    "";
      }

  /etc/nginx/conf.d/gzip.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      # v268: Nginx gzip压缩配置
      gzip on;
      gzip_comp_level 6;
      gzip_min_length 1024;
      gzip_vary on;
      gzip_proxied any;
      gzip_types text/plain text/css text/javascript application/javascript application/json application/xml application/xml+rss image/svg+xml;
      gzip_buffers 16 8k;
      gzip_http_version 1.1;
