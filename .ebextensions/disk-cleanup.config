# 磁盘空间自动清理配置
# 定期清理旧日志和临时文件，防止磁盘耗尽
files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_cleanup_disk.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # 部署后自动清理磁盘空间
      echo "=== Disk cleanup after deployment ==="
      
      # 清理旧的应用部署缓存
      find /opt/elasticbeanstalk/deploy/ -type f -mtime +3 -delete 2>/dev/null || true
      
      # 清理旧日志（保留最近3天）
      find /var/log/ -name "*.gz" -mtime +3 -delete 2>/dev/null || true
      find /var/log/ -name "*.old" -mtime +1 -delete 2>/dev/null || true
      find /var/log/ -name "*.1" -mtime +3 -delete 2>/dev/null || true
      
      # 清理npm缓存
      npm cache clean --force 2>/dev/null || true
      
      # 清理临时文件
      find /tmp/ -type f -mtime +1 -delete 2>/dev/null || true
      
      # 清理旧的EB部署包
      find /opt/elasticbeanstalk/deployment/ -name "*.zip" -mtime +3 -delete 2>/dev/null || true
      
      # 报告磁盘使用情况
      df -h /
      echo "=== Disk cleanup complete ==="

  "/etc/cron.daily/eb-disk-cleanup":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # 每日自动清理磁盘空间
      find /var/log/ -name "*.gz" -mtime +3 -delete 2>/dev/null || true
      find /var/log/ -name "*.old" -mtime +1 -delete 2>/dev/null || true
      find /tmp/ -type f -mtime +1 -delete 2>/dev/null || true
      npm cache clean --force 2>/dev/null || true
      journalctl --vacuum-time=3d 2>/dev/null || true
